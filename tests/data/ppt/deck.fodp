 <office:body>
  <office:presentation>
   <draw:page draw:name="Intro" draw:master-page-name="Default">
    <draw:frame presentation:class="title" svg:x="2cm" svg:y="1cm" svg:width="20cm" svg:height="3cm"><draw:text-box><text:p>Hello, PowerPoint</text:p></draw:text-box></draw:frame>
    <draw:frame presentation:class="outline" svg:x="2cm" svg:y="5cm" svg:width="20cm" svg:height="8cm"><draw:text-box><text:list><text:list-item><text:p>First point</text:p></text:list-item><text:list-item><text:p>Second point</text:p></text:list-item></text:list></draw:text-box></draw:frame>
    <presentation:notes><draw:frame presentation:class="notes" svg:x="2cm" svg:y="14cm" svg:width="17cm" svg:height="10cm"><draw:text-box><text:p>Speaker notes</text:p></draw:text-box></draw:frame></presentation:notes>
   </draw:page>
   <draw:page draw:name="Shapes" draw:master-page-name="Default">
    <draw:frame presentation:class="title" svg:x="2cm" svg:y="1cm" svg:width="20cm" svg:height="3cm"><draw:text-box><text:p>Ünïcödé shapes</text:p></draw:text-box></draw:frame>
    <draw:rect svg:x="3cm" svg:y="6cm" svg:width="6cm" svg:height="4cm"><text:p>Box</text:p></draw:rect>
