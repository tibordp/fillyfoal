<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="12345678-1234-1234-1234-123456789012" Name="Fillyfoal Hello" Language="1033" Version="1.2.3" Manufacturer="fillyfoal" UpgradeCode="87654321-4321-4321-4321-210987654321">
    <Package InstallerVersion="200" Compressed="yes" Comments="MSI fixture" Description="Fillyfoal test package" Manufacturer="fillyfoal"/>
    <Media Id="1" Cabinet="hello.cab" EmbedCab="yes"/>
    <Property Id="GREETING" Value="hello"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLDIR" Name="Hello">
          <Component Id="MainComponent" Guid="11111111-2222-3333-4444-555555555555">
            <File Id="ReadmeFile" Name="readme.txt" Source="readme.txt" KeyPath="yes"/>
            <RegistryValue Root="HKCU" Key="Software\Fillyfoal" Name="Installed" Type="integer" Value="1"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="Hello" Level="1">
      <ComponentRef Id="MainComponent"/>
    </Feature>
  </Product>
</Wix>
