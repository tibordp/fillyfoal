version 1.0;
extension KHR_enable_operator_expressions;

graph tiny( input ) -> ( output )
{
    input = external<scalar>(shape = [1, 3, 224, 224]);
    kernel = variable<scalar>(shape = [16, 3, 3, 3], label = 'conv1/kernel');
    conv = conv(input, kernel, padding = [(1, 1), (1, 1)]);
    output = relu(conv);
}
