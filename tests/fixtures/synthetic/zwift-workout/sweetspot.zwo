<workout_file>
    <author>Coach</author>
    <name>Sweet spot 3x10</name>
    <description>Three ten-minute intervals at 90% FTP.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.75"/>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.90" OffPower="0.55"/>
        <Cooldown Duration="300" PowerLow="0.70" PowerHigh="0.40"/>
    </workout>
</workout_file>
