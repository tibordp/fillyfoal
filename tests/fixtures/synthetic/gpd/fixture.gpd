*%
*% Fixture generic printer description
*%
*GPDSpecVersion: "1.0"
*GPDFileVersionNum: "1.0"
*GPDFileName: "FIXTURE.GPD"
*Include: "StdNames.gpd"
*ModelName: "Fixture DotMatrix 24"
*MasterUnits: PAIR(360, 360)
*PrinterType: SERIAL
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: Resolution
{
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "360 x 360 dots per inch"
        *DPI: PAIR(360, 360)
        *Command: CmdSendBlockData { *Cmd : "<1B>*" %c[0,255]{NumOfDataBytes / 3} }
    }
}
*Command: CmdStartDoc { *Order: DOC_SETUP.1 *Cmd: "<1B>@" }
