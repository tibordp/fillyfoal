# DEF test
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 100000 100000 ) ;
ROW ROW_0 core 0 0 N DO 100 BY 1 STEP 200 0 ;
COMPONENTS 2 ;
- u1 INVX1 + PLACED ( 1000 1000 ) N ;
- u2 DFFX1 + PLACED ( 5000 1000 ) FS ;
END COMPONENTS
PINS 1 ;
- clk + NET clk + DIRECTION INPUT ;
END PINS
NETS 1 ;
- clk ( PIN clk ) ( u2 CK ) ;
END NETS
END DESIGN
